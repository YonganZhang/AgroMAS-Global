From: Yongan Zhang <374456248@qq.com>
Date: Sat, 14 Nov 2026 15:52:26 +0800
Subject: [PATCH] Allow project-local PCSE runtime storage

---
 pcse/util.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/pcse/util.py b/pcse/util.py
index 0675d33..6ba49f5 100644
--- a/pcse/util.py
+++ b/pcse/util.py
@@ -844,6 +844,9 @@ def get_user_home():
     If PCSE runs under a system user then return the temp directory as returned
     by tempfile.gettempdir()
     """
+    project_home = os.getenv("PCSE_PROJECT_HOME")
+    if project_home:
+        return project_home
     user_home = None
     if platform.system() == "Windows":
         user = os.getenv("USERNAME")
